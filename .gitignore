# EstateAI Git ignore rules

# Local AI assistant instructions (kept private, not versioned)
claude.md
CLAUDE.md
.claude/settings.local.json

# Private course documents (proposal, presentations, reports)
docs/

# Machine learning notebooks, datasets and experiments
ml/

# Secrets and environment configuration.
# Supabase keys, database URLs, SMTP and LLM API keys stay local.
# Commit only the *.example templates.
.env
.env.*
!.env.example
**/environments/environment.local.ts
*.pem
*.key
secrets/

# Python and FastAPI backend
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.python-version
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/

# Test, lint and type-check caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ruff_cache/
.mypy_cache/
.tox/

# Angular and Node frontend
node_modules/
.angular/
/frontend/dist/
/frontend/tmp/
/frontend/out-tsc/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# Playwright outputs
test-results/
playwright-report/
playwright/.cache/

# Jupyter notebooks and ML experiment tracking
.ipynb_checkpoints/
mlruns/
mlartifacts/

# Raw and intermediate datasets downloaded from Hugging Face or Kaggle.
# Keep them local or version them with DVC instead of Git.
data/raw/
data/interim/
data/external/
*.parquet
*.feather

# DVC local cache (the .dvc metadata files are still committed)
.dvc/cache/
.dvc/tmp/

# Generated logs and temporary files
*.log
logs/
tmp/
*.tmp

# Editors and operating systems
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
