ENVIRONMENT=development

# JSON list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=["http://localhost:4200"]

# Supabase PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<database-password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres

# Supabase project URL, used to verify sign-in tokens.
SUPABASE_URL=https://<project-ref>.supabase.co
